+        private static int clamp(Integer value, int minimum, int maximum, int fallback, String worldName, String setting) {
+            if (value == null) {
+                Bukkit.getLogger().warning("Missing knockback setting '" + setting + "' for world '" + worldName
+                        + "'; using " + fallback + ".");
+                return fallback;
+            }
+            int clamped = Math.max(minimum, Math.min(maximum, value));
+            if (clamped != value) {
+                Bukkit.getLogger().warning("Knockback setting '" + setting + "' for world '" + worldName
+                        + "' is outside the supported range; clamped to " + clamped + ".");
+            }
+            return clamped;
+        }
+
         private static double clamp(double value, double minimum, double maximum, double fallback, String worldName, String setting) {
             if (Double.isNaN(value) || Double.isInfinite(value)) {
                 Bukkit.getLogger().warning("Invalid knockback value '" + setting + "' for world '" + worldName + "'; using " + fallback + ".");
