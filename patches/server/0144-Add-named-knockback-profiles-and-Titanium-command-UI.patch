+    public static synchronized String getWorldProfileName(String worldName) {
+        return "default".equals(worldName) ? defaultWorldProfile
+                : worldProfiles.getOrDefault(worldName, defaultWorldProfile);
+    }
+
+    public static synchronized List<String> getProfileNames() {
+        return Collections.unmodifiableList(new ArrayList<>(profiles.keySet()));
+    }
+
+    public static synchronized WorldConfig getProfile(String profileName) {
+        return profiles.get(normalizeProfileName(profileName));
+    }
+
+    public static synchronized void createProfile(String profileName, String baseProfileName) {
+        String name = normalizeProfileName(profileName);
+        validateProfileName(name);
+        if (profiles.containsKey(name)) {
+            throw new IllegalArgumentException("A profile named '" + name + "' already exists.");
+        }
+
+        WorldConfig base = baseProfileName == null
+                ? getWorldConfig("default")
+                : profiles.get(normalizeProfileName(baseProfileName));
+        if (base == null) {
+            throw new IllegalArgumentException("Unknown base profile '" + baseProfileName + "'.");
+        }
+
+        WorldConfig profile = copy(base);
+        profiles.put(name, profile);
+        configRoot.node("profiles").node(name).set(profile);
+        save();
+    }
+
+    public static synchronized void setWorldProfile(String worldName, String profileName) {
+        String name = normalizeProfileName(profileName);
+        if (!profiles.containsKey(name)) {
+            throw new IllegalArgumentException("Unknown knockback profile '" + profileName + "'.");
+        }
+
+        configRoot.node("worlds").node(worldName).node("profile").set(name);
+        if ("default".equals(worldName)) {
+            defaultWorldProfile = name;
+        } else {
+            worldProfiles.put(worldName, name);
+        }
+        save();
+    }
+
+    public static synchronized void setProfileValue(String profileName, String path, String rawValue) {
+        String name = normalizeProfileName(profileName);
+        WorldConfig config = profiles.get(name);
+        if (config == null) {
+            throw new IllegalArgumentException("Unknown knockback profile '" + profileName + "'.");
+        }
+
+        String[] parts = path.toLowerCase(Locale.ROOT).replace("-", "").replace("_", "").split("\\.", 2);
+        if (parts.length == 1) {
+            setWorldValue(config, parts[0], rawValue);
+        } else {
+            Profile profile = getDamageProfile(config, parts[0]);
+            if (profile == null) {
+                throw new IllegalArgumentException("Unknown damage profile '" + parts[0] + "'.");
+            }
+            setDamageValue(profile, parts[1], rawValue);
+        }
+
+        config.validate("profile '" + name + "'");
+        configRoot.node("profiles").node(name).set(config);
+        save();
+    }
+
+    public static synchronized void removeProfile(String profileName) {
+        String name = normalizeProfileName(profileName);
+        if ("default".equals(name)) {
+            throw new IllegalArgumentException("The default profile cannot be removed.");
+        }
+        if (!profiles.containsKey(name)) {
+            throw new IllegalArgumentException("Unknown knockback profile '" + profileName + "'.");
+        }
+        if (name.equals(defaultWorldProfile) || worldProfiles.containsValue(name)) {
+            throw new IllegalArgumentException("That profile is assigned to a world. Assign another profile first.");
+        }
+
+        profiles.remove(name);
+        configRoot.node("profiles").node(name).set(null);
+        save();
+    }
+
+    public static synchronized void save() {
+        try {
+            configLoader.save(configRoot);
+        } catch (IOException e) {
+            throw Throwables.propagate(e);
+        }
+    }
+
+    public static synchronized void reload() {
+        if (configFile == null) {
+            throw new IllegalStateException("Knockback configuration has not been initialized.");
+        }
+        init(configFile);
+    }
+
+    private static void setWorldValue(WorldConfig config, String path, String value) {
+        switch (path) {
+            case "mode":
+                if (!"vanilla".equalsIgnoreCase(value) && !"custom".equalsIgnoreCase(value)) {
+                    throw new IllegalArgumentException("mode must be VANILLA or CUSTOM.");
+                }
+                config.mode = value.toUpperCase(Locale.ROOT);
+                break;
+            case "requiressprint":
+                config.requiresSprint = parseBoolean(path, value);
+                break;
+            case "pulldown":
+                config.pullDown = parseDouble(path, value);
+                break;
+            case "verticalvelocityminimum":
+                config.verticalVelocityMinimum = parseDouble(path, value);
+                break;
+            case "resistancemultiplier":
+                config.resistanceMultiplier = parseDouble(path, value);
+                break;
+            case "attackerslowdown":
+                config.attackerSlowdown = parseDouble(path, value);
+                break;
+            case "stackvelocity":
+                config.stackVelocity = parseBoolean(path, value);
+                break;
+            case "resethorizontalvelocity":
+                config.resetHorizontalVelocity = parseBoolean(path, value);
+                break;
+            case "resetverticalvelocity":
+                config.resetVerticalVelocity = parseBoolean(path, value);
+                break;
+            case "groundknockbackenabled":
+                config.groundKnockbackEnabled = parseBoolean(path, value);
+                break;
+            case "airknockbackenabled":
+                config.airKnockbackEnabled = parseBoolean(path, value);
+                break;
+            case "groundhorizontalmultiplier":
+                config.groundHorizontalMultiplier = parseDouble(path, value);
+                break;
+            case "groundverticalmultiplier":
+                config.groundVerticalMultiplier = parseDouble(path, value);
+                break;
+            case "airhorizontalmultiplier":
+                config.airHorizontalMultiplier = parseDouble(path, value);
+                break;
+            case "airverticalmultiplier":
+                config.airVerticalMultiplier = parseDouble(path, value);
+                break;
+            default:
+                throw new IllegalArgumentException("Unknown knockback setting '" + path + "'.");
+        }
+    }
+
+    private static void setDamageValue(Profile profile, String path, String value) {
+        switch (path) {
+            case "horizontal":
+            case "horizontalmultiplier":
+                profile.horizontalMultiplier = parseDouble(path, value);
+                break;
+            case "vertical":
+            case "verticalmultiplier":
+                profile.verticalMultiplier = parseDouble(path, value);
+                break;
+            case "friction":
+            case "frictionmultiplier":
+                profile.frictionMultiplier = parseDouble(path, value);
+                break;
+            case "horizontaldrag":
+            case "horizontaldragmultiplier":
+                profile.horizontalDragMultiplier = parseDouble(path, value);
+                break;
+            case "verticaldrag":
+            case "verticaldragmultiplier":
+                profile.verticalDragMultiplier = parseDouble(path, value);
+                break;
+            case "verticallimit":
+            case "verticallimitmultiplier":
+                profile.verticalLimitMultiplier = parseDouble(path, value);
+                break;
+            case "sprinthorizontal":
+            case "sprinthorizontalmultiplier":
+                profile.sprintHorizontalMultiplier = parseDouble(path, value);
+                break;
+            case "sprintvertical":
+            case "sprintverticalmultiplier":
+                profile.sprintVerticalMultiplier = parseDouble(path, value);
+                break;
+            case "resistance":
+            case "resistancemultiplier":
+                profile.resistanceMultiplier = parseDouble(path, value);
+                break;
+            case "attackerslowdown":
+            case "attackerslowdownmultiplier":
+                profile.attackerSlowdownMultiplier = parseDouble(path, value);
+                break;
+            default:
+                throw new IllegalArgumentException("Unknown damage-profile setting '" + path + "'.");
+        }
+    }
+
+    private static Profile getDamageProfile(WorldConfig config, String name) {
+        switch (name) {
+            case "normalmelee": return config.normalMelee;
+            case "sprint": return config.sprint;
+            case "critical": return config.critical;
+            case "arrows": return config.arrows;
+            case "snowballs": return config.snowballs;
+            case "eggs": return config.eggs;
+            case "fishinghooks": return config.fishingHooks;
+            case "enderpearls": return config.enderPearls;
+            case "explosions": return config.explosions;
+            case "other": return config.other;
+            default: return null;
+        }
+    }
+
+    private static double parseDouble(String path, String value) {
+        try {
+            double parsed = Double.parseDouble(value);
+            if (Double.isNaN(parsed) || Double.isInfinite(parsed)) {
+                throw new NumberFormatException("not finite");
+            }
+            return parsed;
+        } catch (NumberFormatException e) {
+            throw new IllegalArgumentException("Setting '" + path + "' must be a finite number.", e);
+        }
+    }
+
+    private static boolean parseBoolean(String path, String value) {
+        if ("true".equalsIgnoreCase(value)) return true;
+        if ("false".equalsIgnoreCase(value)) return false;
+        throw new IllegalArgumentException("Setting '" + path + "' must be true or false.");
+    }
+
+    private static String normalizeProfileName(String name) {
+        return name == null ? null : name.toLowerCase(Locale.ROOT);
+    }
+
+    private static boolean isValidProfileName(String name) {
+        return name != null && PROFILE_NAME_PATTERN.matcher(name).matches();
+    }
+
+    private static void validateProfileName(String name) {
+        if (!isValidProfileName(name)) {
+            throw new IllegalArgumentException("Profile names may contain only letters, numbers, '_' and '-' (1-32 characters).");
+        }
+    }
+
+    private static WorldConfig copy(WorldConfig source) {
+        WorldConfig copy = new WorldConfig();
+        copy.mode = source.mode;
+        copy.requiresSprint = source.requiresSprint;
+        copy.pullDown = source.pullDown;
+        copy.verticalVelocityMinimum = source.verticalVelocityMinimum;
+        copy.resistanceMultiplier = source.resistanceMultiplier;
+        copy.attackerSlowdown = source.attackerSlowdown;
+        copy.stackVelocity = source.stackVelocity;
+        copy.resetHorizontalVelocity = source.resetHorizontalVelocity;
+        copy.resetVerticalVelocity = source.resetVerticalVelocity;
+        copy.groundKnockbackEnabled = source.groundKnockbackEnabled;
+        copy.airKnockbackEnabled = source.airKnockbackEnabled;
+        copy.groundHorizontalMultiplier = source.groundHorizontalMultiplier;
+        copy.groundVerticalMultiplier = source.groundVerticalMultiplier;
+        copy.airHorizontalMultiplier = source.airHorizontalMultiplier;
+        copy.airVerticalMultiplier = source.airVerticalMultiplier;
+        copy.normalMelee = copy(source.normalMelee);
+        copy.sprint = copy(source.sprint);
+        copy.critical = copy(source.critical);
+        copy.arrows = copy(source.arrows);
+        copy.snowballs = copy(source.snowballs);
+        copy.eggs = copy(source.eggs);
+        copy.fishingHooks = copy(source.fishingHooks);
+        copy.enderPearls = copy(source.enderPearls);
+        copy.explosions = copy(source.explosions);
+        copy.other = copy(source.other);
+        return copy;
+    }
+
+    private static Profile copy(Profile source) {
+        Profile copy = new Profile();
+        copy.frictionMultiplier = source.frictionMultiplier;
+        copy.horizontalDragMultiplier = source.horizontalDragMultiplier;
+        copy.verticalDragMultiplier = source.verticalDragMultiplier;
+        copy.horizontalMultiplier = source.horizontalMultiplier;
+        copy.verticalMultiplier = source.verticalMultiplier;
+        copy.verticalLimitMultiplier = source.verticalLimitMultiplier;
+        copy.sprintHorizontalMultiplier = source.sprintHorizontalMultiplier;
+        copy.sprintVerticalMultiplier = source.sprintVerticalMultiplier;
+        copy.resistanceMultiplier = source.resistanceMultiplier;
+        copy.attackerSlowdownMultiplier = source.attackerSlowdownMultiplier;
+        return copy;
+    }
