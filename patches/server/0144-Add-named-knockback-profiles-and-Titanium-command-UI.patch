-    public static WorldConfig getWorldConfig(String worldName) {
+    public static synchronized WorldConfig getWorldConfig(String worldName) {
+        String profileName = "default".equals(worldName) ? defaultWorldProfile : worldProfiles.get(worldName);
+        if (profileName != null) {
+            WorldConfig profile = profiles.get(profileName);
