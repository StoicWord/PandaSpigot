@@ -0,0 +1,78 @@
+package org.spigotmc;
+
+import org.bukkit.ChatColor;
+import org.bukkit.configuration.InvalidConfigurationException;
+import org.bukkit.configuration.file.YamlConfiguration;
+
+import java.io.File;
+import java.io.IOException;
+
+public final class TitaniumSettings {
+    private static File folder;
+    private static YamlConfiguration config;
+
+    private TitaniumSettings() {}
+
+    public static synchronized void init(File worldContainer) {
+        folder = new File(worldContainer, "titanium");
+        if (!folder.isDirectory() && !folder.mkdirs()) {
+            throw new IllegalStateException("Could not create Titanium settings folder: " + folder);
+        }
+
+        File file = new File(folder, "settings.yml");
+        config = new YamlConfiguration();
+        if (file.isFile()) {
+            try {
+                config.load(file);
+            } catch (IOException | InvalidConfigurationException e) {
+                throw new IllegalStateException("Could not load Titanium settings from " + file, e);
+            }
+        }
+
+        config.addDefault("brand.name", "Titanium");
+        config.addDefault("brand.version", "1.0");
+        config.addDefault("brand.author", "Hyouka Dev");
+        config.addDefault("brand.discord", "dsc.gg/hyoukadev");
+        config.addDefault("theme.primary", "&d");
+        config.addDefault("theme.secondary", "&7");
+        config.addDefault("theme.text", "&f");
+        config.addDefault("commands.knockback.enabled", true);
+        config.addDefault("commands.plugin-manager.enabled", true);
+        config.addDefault("commands.spark-alias.enabled", true);
+        config.options().header("Titanium 1.0 settings. Colors use legacy Minecraft color codes.");
+        config.options().copyDefaults(true);
+        try {
+            config.save(file);
+        } catch (IOException e) {
+            throw new IllegalStateException("Could not save Titanium settings to " + file, e);
+        }
+    }
+
+    public static synchronized String getBrandName() {
+        return config.getString("brand.name", "Titanium");
+    }
+
+    public static synchronized String getBrandVersion() {
+        return config.getString("brand.version", "1.0");
