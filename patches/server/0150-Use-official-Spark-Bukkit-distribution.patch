+        if (TitaniumSettings.isCommandEnabled("commands.spark.enabled")) {
             installBundledSpark();
-            MinecraftServer.getServer().server.getCommandMap().register("Titanium", new SparkAliasCommand());
         }
     }
 
     private static void installBundledSpark() {
         File pluginsFolder = Bukkit.getPluginsFolder();
-        File sparkJar = new File(pluginsFolder, "spark.jar");
-        if (sparkJar.isFile()) {
-            return;
-        }
         if (!pluginsFolder.isDirectory() && !pluginsFolder.mkdirs()) {
             Bukkit.getLogger().severe("Could not create plugins directory for bundled Spark: " + pluginsFolder);
             return;
         }
 
+        File[] existingSparkJars = pluginsFolder.listFiles((directory, name) -> {
+            String lowerCaseName = name.toLowerCase(Locale.ROOT);
+            return lowerCaseName.startsWith("spark") && lowerCaseName.endsWith(".jar");
+        });
+        if (existingSparkJars == null) {
+            Bukkit.getLogger().severe("Could not inspect plugins directory for Spark: " + pluginsFolder);
+            return;
+        }
+        if (existingSparkJars.length > 0) {
+            return;
+        }
+
+        File sparkJar = new File(pluginsFolder, "spark.jar");
         try (InputStream input = TitaniumCommands.class.getResourceAsStream(
-                "/META-INF/titanium/spark-bukkit-1.0.jar")) {
+                "/META-INF/titanium/spark-bukkit.jar")) {
             if (input == null) {
                 Bukkit.getLogger().severe("Bundled Spark resource is missing; /spark will be unavailable.");
                 return;
