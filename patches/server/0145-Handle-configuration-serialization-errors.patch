From: StoicWord <134773085+StoicWord@users.noreply.github.com>
Date: Thu, 19 Nov 2026 09:59:41 +0000
Subject: [PATCH] Handle configuration serialization errors

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>

diff --git a/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotKnockbackConfig.java b/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotKnockbackConfig.java
index bfd1ed8ffe020ef67d7a0bb39e760df2e1f3d0b2..95a8cd4dc13857d7f81cd175c9cfe41de92afcb7 100644
--- a/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotKnockbackConfig.java
+++ b/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotKnockbackConfig.java
@@ -18,6 +18,7 @@ import org.spongepowered.configurate.ConfigurationNode;
 import org.spongepowered.configurate.objectmapping.ConfigSerializable;
 import org.spongepowered.configurate.objectmapping.ObjectMapper;
 import org.spongepowered.configurate.objectmapping.meta.Comment;
+import org.spongepowered.configurate.serialize.SerializationException;
 import org.spongepowered.configurate.util.MapFactories;
 import org.spongepowered.configurate.util.NamingSchemes;
 
@@ -174,7 +175,7 @@ public final class PandaSpigotKnockbackConfig {
 
         WorldConfig profile = copy(base);
         profiles.put(name, profile);
-        configRoot.node("profiles").node(name).set(profile);
+        setNode(configRoot.node("profiles").node(name), profile);
         save();
     }
 
@@ -184,7 +185,7 @@ public final class PandaSpigotKnockbackConfig {
             throw new IllegalArgumentException("Unknown knockback profile '" + profileName + "'.");
         }
 
-        configRoot.node("worlds").node(worldName).node("profile").set(name);
+        setNode(configRoot.node("worlds").node(worldName).node("profile"), name);
         if ("default".equals(worldName)) {
             defaultWorldProfile = name;
         } else {
@@ -212,7 +213,7 @@ public final class PandaSpigotKnockbackConfig {
         }
 
         config.validate("profile '" + name + "'");
-        configRoot.node("profiles").node(name).set(config);
+        setNode(configRoot.node("profiles").node(name), config);
         save();
     }
 
@@ -229,7 +230,7 @@ public final class PandaSpigotKnockbackConfig {
         }
 
         profiles.remove(name);
-        configRoot.node("profiles").node(name).set(null);
+        setNode(configRoot.node("profiles").node(name), null);
         save();
     }
 
@@ -241,6 +242,14 @@ public final class PandaSpigotKnockbackConfig {
         }
     }
 
+    private static void setNode(ConfigurationNode node, Object value) {
+        try {
+            node.set(value);
+        } catch (SerializationException e) {
+            throw Throwables.propagate(e);
+        }
+    }
+
     public static synchronized void reload() {
         if (configFile == null) {
             throw new IllegalStateException("Knockback configuration has not been initialized.");
