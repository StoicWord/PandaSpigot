diff --git a/src/main/java/org/spigotmc/TitaniumCommands.java b/src/main/java/org/spigotmc/TitaniumCommands.java
new file mode 100644
index 0000000000000000000000000000000000000000..ad637dff690bbc95c91b68c5e6519a3f46159903
--- /dev/null
+++ b/src/main/java/org/spigotmc/TitaniumCommands.java
@@ -0,0 +1,287 @@
+package org.spigotmc;
+
+import com.hpfxd.pandaspigot.config.PandaSpigotConfig;
+import com.hpfxd.pandaspigot.config.PandaSpigotKnockbackConfig;
+import com.hpfxd.pandaspigot.config.PandaSpigotWorldConfig;
+import net.minecraft.server.MinecraftServer;
+import org.bukkit.Bukkit;
+import org.bukkit.ChatColor;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import org.bukkit.permissions.Permission;
+import org.bukkit.permissions.PermissionDefault;
+import org.bukkit.plugin.InvalidDescriptionException;
+import org.bukkit.plugin.InvalidPluginException;
+import org.bukkit.plugin.Plugin;
+import org.bukkit.plugin.PluginManager;
+import org.bukkit.plugin.UnknownDependencyException;
+
+import java.io.File;
+import java.io.IOException;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Locale;
+
+public final class TitaniumCommands {
+    private static final String KNOCKBACK_PERMISSION = "titanium.knockback.view";
+    private static final String PLUGIN_PERMISSION = "titanium.plugin.manage";
+
+    private TitaniumCommands() {}
+
+    public static void register() {
+        registerPermission(KNOCKBACK_PERMISSION);
+        registerPermission(PLUGIN_PERMISSION);
+
+        MinecraftServer.getServer().server.getCommandMap().register("Titanium", new AboutCommand());
+        MinecraftServer.getServer().server.getCommandMap().register("Titanium", new KnockbackCommand());
+        MinecraftServer.getServer().server.getCommandMap().register("Titanium", new PluginManagerCommand());
+    }
+
+    private static void registerPermission(String name) {
+        if (Bukkit.getPluginManager().getPermission(name) == null) {
+            Bukkit.getPluginManager().addPermission(new Permission(name, PermissionDefault.OP));
+        }
+    }
+
+    private static final class AboutCommand extends Command {
+        private AboutCommand() {
+            super("titanium");
+            this.description = "Shows Titanium server information";
+            this.usageMessage = "/titanium";
+        }
+
+        @Override
+        public boolean execute(CommandSender sender, String label, String[] args) {
+            sender.sendMessage(ChatColor.GOLD + "Titanium 1.0");
+            sender.sendMessage(ChatColor.GRAY + "Author: Hyouka Dev");
+            sender.sendMessage(ChatColor.GRAY + "Discord: https://dsc.gg/hyoukadev");
+            return true;
+        }
+    }
+
+    private static final class KnockbackCommand extends Command {
+        private KnockbackCommand() {
+            super("kb");
+            this.description = "Shows the active knockback profile";
+            this.usageMessage = "/kb";
+            this.setAliases(Arrays.asList("combat"));
+            this.setPermission(KNOCKBACK_PERMISSION);
+        }
+
+        @Override
+        public boolean execute(CommandSender sender, String label, String[] args) {
+            if (!this.testPermission(sender)) {
+                return true;
+            }
+
+            String worldName = "default";
+            if (sender instanceof org.bukkit.entity.Player) {
+                worldName = ((org.bukkit.entity.Player) sender).getWorld().getName();
+            }
+
+            PandaSpigotKnockbackConfig.WorldConfig displacement =
+                    PandaSpigotKnockbackConfig.getWorldConfig(worldName);
+            PandaSpigotWorldConfig.KnockbackConfig legacy =
+                    PandaSpigotConfig.getWorldConfig(worldName).knockback;
+
+            sender.sendMessage(ChatColor.GOLD + "Titanium knockback - " + worldName + " (" + displacement.mode + ")");
+            sender.sendMessage(ChatColor.GRAY + "Legacy: friction=" + legacy.friction
+                    + ", horizontal=" + legacy.horizontal + ", vertical=" + legacy.vertical
+                    + ", verticalLimit=" + legacy.verticalLimit + ", extraHorizontal=" + legacy.extraHorizontal
+                    + ", extraVertical=" + legacy.extraVertical);
+            sender.sendMessage(ChatColor.GRAY + "pullDown=" + displacement.pullDown
+                    + ", stackVelocity=" + displacement.stackVelocity
+                    + ", attackerSlowdown=" + displacement.attackerSlowdown);
+            sendProfile(sender, "normalMelee", displacement.normalMelee);
+            sendProfile(sender, "sprint", displacement.sprint);
+            sendProfile(sender, "critical", displacement.critical);
+            sendProfile(sender, "arrows", displacement.arrows);
+            sendProfile(sender, "snowballs", displacement.snowballs);
+            sendProfile(sender, "eggs", displacement.eggs);
+            sendProfile(sender, "fishingHooks", displacement.fishingHooks);
+            sendProfile(sender, "enderPearls", displacement.enderPearls);
+            sendProfile(sender, "explosions", displacement.explosions);
+            sendProfile(sender, "other", displacement.other);
+            return true;
+        }
+
+        private static void sendProfile(CommandSender sender, String name, PandaSpigotKnockbackConfig.Profile profile) {
+            sender.sendMessage(ChatColor.GRAY + name + ": horizontal=" + profile.horizontalMultiplier
+                    + ", vertical=" + profile.verticalMultiplier
+                    + ", friction=" + profile.frictionMultiplier
+                    + ", horizontalDrag=" + profile.horizontalDragMultiplier
+                    + ", verticalDrag=" + profile.verticalDragMultiplier);
+        }
+    }
+
+    private static final class PluginManagerCommand extends Command {
+        private PluginManagerCommand() {
+            super("plugin");
+            this.description = "Manages loaded plugins";
+            this.usageMessage = "/plugin <enable|disable|load|reload> <plugin>";
+            this.setPermission(PLUGIN_PERMISSION);
+        }
+
+        @Override
+        public boolean execute(CommandSender sender, String label, String[] args) {
+            if (!this.testPermission(sender)) {
+                return true;
+            }
+            if (args.length != 2) {
+                sender.sendMessage(ChatColor.YELLOW + this.usageMessage);
+                return true;
+            }
+
+            PluginManager pluginManager = Bukkit.getPluginManager();
+            String action = args[0].toLowerCase(Locale.ROOT);
+            String pluginName = args[1];
+            switch (action) {
+                case "enable":
+                    enable(sender, pluginManager, pluginManager.getPlugin(pluginName));
+                    break;
+                case "disable":
+                    disable(sender, pluginManager, pluginManager.getPlugin(pluginName));
+                    break;
+                case "load":
+                    load(sender, pluginManager, pluginName);
+                    break;
+                case "reload":
+                    reload(sender, pluginManager, pluginManager.getPlugin(pluginName));
+                    break;
+                default:
+                    sender.sendMessage(ChatColor.YELLOW + this.usageMessage);
+            }
+            return true;
+        }
+
+        private static void enable(CommandSender sender, PluginManager manager, Plugin plugin) {
+            if (plugin == null) {
+                sender.sendMessage(ChatColor.RED + "That plugin is not loaded.");
+                return;
+            }
+            if (plugin.isEnabled()) {
+                sender.sendMessage(ChatColor.YELLOW + plugin.getName() + " is already enabled.");
+                return;
+            }
+            for (String dependency : plugin.getDescription().getDepend()) {
+                if (!manager.isPluginEnabled(dependency)) {
+                    sender.sendMessage(ChatColor.RED + "Cannot enable " + plugin.getName()
+                            + ": required dependency " + dependency + " is not enabled.");
+                    return;
+                }
+            }
+
+            manager.enablePlugin(plugin);
+            if (manager.isPluginEnabled(plugin)) {
+                sender.sendMessage(ChatColor.GREEN + "Enabled " + plugin.getName() + ".");
+            } else {
+                sender.sendMessage(ChatColor.RED + "Plugin manager could not enable " + plugin.getName()
+                        + "; check the server log for the plugin error.");
+            }
+        }
+
+        private static void disable(CommandSender sender, PluginManager manager, Plugin plugin) {
+            if (plugin == null) {
+                sender.sendMessage(ChatColor.RED + "That plugin is not loaded.");
+                return;
+            }
+            if (!plugin.isEnabled()) {
+                sender.sendMessage(ChatColor.YELLOW + plugin.getName() + " is already disabled.");
+                return;
+            }
+            Plugin dependent = findEnabledDependent(manager, plugin);
+            if (dependent != null) {
+                sender.sendMessage(ChatColor.RED + "Cannot disable " + plugin.getName()
+                        + " while required plugin " + dependent.getName() + " is enabled.");
+                return;
+            }
+
+            manager.disablePlugin(plugin);
+            if (!manager.isPluginEnabled(plugin)) {
+                sender.sendMessage(ChatColor.GREEN + "Disabled " + plugin.getName() + ".");
+            } else {
+                sender.sendMessage(ChatColor.RED + "Plugin manager could not disable " + plugin.getName()
+                        + "; check the server log for the plugin error.");
+            }
+        }
+
+        private static void load(CommandSender sender, PluginManager manager, String pluginName) {
+            if (manager.getPlugin(pluginName) != null) {
+                sender.sendMessage(ChatColor.YELLOW + pluginName + " is already loaded.");
+                return;
+            }
+
+            String jarName = pluginName.toLowerCase(Locale.ROOT).endsWith(".jar")
+                    ? pluginName : pluginName + ".jar";
+            File pluginsFolder = Bukkit.getPluginsFolder();
+            try {
+                File folder = pluginsFolder.getCanonicalFile();
+                File file = new File(pluginsFolder, jarName).getCanonicalFile();
+                if (!folder.equals(file.getParentFile()) || !file.isFile()) {
+                    sender.sendMessage(ChatColor.RED + "Plugin JAR not found in the plugins folder: " + jarName);
+                    return;
+                }
+
+                Plugin plugin = manager.loadPlugin(file);
+                if (plugin == null) {
+                    sender.sendMessage(ChatColor.RED + "The plugin loader did not load " + jarName + ".");
+                } else {
+                    sender.sendMessage(ChatColor.GREEN + "Loaded " + plugin.getName()
+                            + " (disabled). Run /plugin enable " + plugin.getName() + " to enable it.");
+                }
+            } catch (InvalidDescriptionException | InvalidPluginException | UnknownDependencyException e) {
+                sender.sendMessage(ChatColor.RED + "Could not load " + jarName + ": " + e.getMessage());
+                Bukkit.getLogger().warning("Could not load plugin JAR " + jarName + ": " + e.getMessage());
+            } catch (IOException e) {
+                sender.sendMessage(ChatColor.RED + "Could not resolve plugin JAR " + jarName + ": " + e.getMessage());
+                Bukkit.getLogger().warning("Could not resolve plugin JAR " + jarName + ": " + e.getMessage());
+            }
+        }
+
+        private static void reload(CommandSender sender, PluginManager manager, Plugin plugin) {
+            if (plugin == null) {
+                sender.sendMessage(ChatColor.RED + "That plugin is not loaded.");
+                return;
+            }
+
+            Plugin dependent = findEnabledDependent(manager, plugin);
+            if (dependent != null) {
+                sender.sendMessage(ChatColor.RED + "Cannot reload " + plugin.getName()
+                        + " while required plugin " + dependent.getName() + " is enabled.");
+                return;
+            }
+            if (plugin.isEnabled()) {
+                manager.disablePlugin(plugin);
+                if (manager.isPluginEnabled(plugin)) {
+                    sender.sendMessage(ChatColor.RED + "Plugin manager could not disable " + plugin.getName()
+                            + "; check the server log for the plugin error.");
+                    return;
+                }
+            }
+
+            manager.enablePlugin(plugin);
+            if (manager.isPluginEnabled(plugin)) {
+                sender.sendMessage(ChatColor.GREEN + "Reloaded " + plugin.getName()
+                        + " using its existing classloader. Restart the server to replace plugin code.");
+            } else {
+                sender.sendMessage(ChatColor.RED + "Plugin manager could not enable " + plugin.getName()
+                        + "; check the server log for the plugin error.");
+            }
+        }
+
+        private static Plugin findEnabledDependent(PluginManager manager, Plugin plugin) {
+            for (Plugin candidate : manager.getPlugins()) {
+                if (!candidate.isEnabled() || candidate == plugin) {
+                    continue;
+                }
+                List<String> dependencies = candidate.getDescription().getDepend();
+                for (String dependency : dependencies) {
+                    if (dependency.equalsIgnoreCase(plugin.getName())) {
+                        return candidate;
+                    }
+                }
+            }
+            return null;
+        }
+    }
+}
